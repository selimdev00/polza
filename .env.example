# Скопируйте в .env и при необходимости поправьте.
# Значения ниже совпадают с docker-compose.yml, локально менять не нужно.
DATABASE_URL=postgresql://polza:polza@localhost:5433/polza

# Секрет для POST /api/revalidate-companies (см. комментарий в
# src/app/api/revalidate-companies/route.ts). Локально можно не задавать -
# без секрета эндпойнт работает как раньше, если NODE_ENV не production.
# На проде без этой переменной эндпойнт отказывает всегда.
REVALIDATE_SECRET=change-me
